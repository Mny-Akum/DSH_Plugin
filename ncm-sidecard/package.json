{
  "name": "dsh-plugin-ncm-sidecard",
  "version": "0.5.0",
  "private": true,
  "description": "Sidebar control card for @wolfgenerals/ncm-player: when the player is closed/hidden, its controls, bilingual lyrics, play queue and an optional poster-derived (Material) palette move into the sidebar.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}


